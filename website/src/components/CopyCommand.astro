---
export interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="copy-command">
  <span class="copy-command-text"><span class="cc-prompt">❯</span>{command}</span>
  <button class="copy-command-btn" type="button" data-copy={command} aria-label="复制命令" title="复制">
    ⧉
  </button>
</div>
