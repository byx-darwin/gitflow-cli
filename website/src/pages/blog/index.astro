---
import Base from "../../layouts/Base.astro";
import { DOGFOODING_BLOG_POST, JEV_BLOG_POST } from "../../data/blog";
import { generateBlogJsonLd } from "../../lib/jsonld";

const base = import.meta.env.BASE_URL;
const blogJsonLd = generateBlogJsonLd();
const articleHref = (path: string) => `${base}${path.slice(1)}`;
---

<Base
  title="博客 | gf"
  description="gf 的工程实践、设计取舍与评估记录，包括 Jev 类型化 AI 决策层的接入与安全边界。"
  socialImage="assets/jev-decision-flow.webp"
  structuredData={[blogJsonLd]}
>
  <main class="blog-index">
    <header class="blog-index-header">
      <p class="blog-index-label">工程实践</p>
      <h1>把判断写进<br /><span>可验证的边界。</span></h1>
      <p>记录 gf 在跨平台工作流、Agent 工程纪律和类型化 AI 决策上的真实实现与评估。</p>
    </header>

    <section class="blog-lead-story" aria-labelledby="jev-story-title">
      <a class="blog-lead-visual" href={articleHref(JEV_BLOG_POST.path)}>
        <img
          src={`${base}/assets/jev-decision-flow.webp`}
          width="1600"
          height="667"
          alt="Jev 类型化决策信号通过 gf 的校验和授权边界"
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <div class="blog-lead-copy">
        <div class="blog-story-meta">
          <time datetime={JEV_BLOG_POST.datePublished}>{JEV_BLOG_POST.datePublished}</time>
          {JEV_BLOG_POST.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h2 id="jev-story-title">
          <a href={articleHref(JEV_BLOG_POST.path)}>{JEV_BLOG_POST.title}</a>
        </h2>
        <p>
          {JEV_BLOG_POST.description}
        </p>
        <a class="text-link" href={articleHref(JEV_BLOG_POST.path)}>阅读全文 →</a>
      </div>
    </section>

    <section class="blog-archive" aria-labelledby="archive-title">
      <p class="blog-index-label" id="archive-title">更多实践记录</p>
      <article class="blog-archive-story">
        <div class="blog-story-meta">
          <time datetime={DOGFOODING_BLOG_POST.datePublished}>{DOGFOODING_BLOG_POST.datePublished}</time>
          <span>{DOGFOODING_BLOG_POST.dateModified} 更新</span>
          {DOGFOODING_BLOG_POST.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h2><a href={articleHref(DOGFOODING_BLOG_POST.path)}>{DOGFOODING_BLOG_POST.title}</a></h2>
        <p>{DOGFOODING_BLOG_POST.description}</p>
        <a class="text-link" href={articleHref(DOGFOODING_BLOG_POST.path)}>阅读全文 →</a>
      </article>
    </section>
  </main>
</Base>
