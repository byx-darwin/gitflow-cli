---
import Base from "../../layouts/Base.astro";
import { BLOG_POSTS } from "../../data/blog";
import { generateBlogJsonLd } from "../../lib/jsonld";
import { withBasePath } from "../../lib/paths";

const base = import.meta.env.BASE_URL;
const blogJsonLd = generateBlogJsonLd();
const [leadPost, ...archivePosts] = BLOG_POSTS;
const articleHref = (path: string) => withBasePath(base, path);
---

<Base
  title="博客 | gf"
  description="gf 的工程实践、设计取舍与评估记录，包括 Jev 类型化 AI 决策层的接入与安全边界。"
  socialImage="assets/jev-decision-flow.webp"
  structuredData={[blogJsonLd]}
>
  <main class="blog-index">
    <header class="blog-index-header">
      <p class="blog-index-label">工程实践</p>
      <h1>把判断写进<br /><span>可验证的边界。</span></h1>
      <p>记录 gf 在跨平台工作流、Agent 工程纪律和类型化 AI 决策上的真实实现与评估。</p>
    </header>

    <section class="blog-lead-story" aria-labelledby="lead-story-title">
      <a class="blog-lead-visual" href={articleHref(leadPost.path)}>
        <img
          src={articleHref(leadPost.image)}
          width="1600"
          height="667"
          alt={`${leadPost.title}配图`}
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <div class="blog-lead-copy">
        <div class="blog-story-meta">
          <time datetime={leadPost.datePublished}>{leadPost.datePublished}</time>
          {leadPost.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h2 id="lead-story-title">
          <a href={articleHref(leadPost.path)}>{leadPost.title}</a>
        </h2>
        <p>
          {leadPost.description}
        </p>
        <a class="text-link" href={articleHref(leadPost.path)}>阅读全文 →</a>
      </div>
    </section>

    {archivePosts.length > 0 && (
      <section class="blog-archive" aria-labelledby="archive-title">
        <p class="blog-index-label" id="archive-title">更多实践记录</p>
        <div class="blog-archive-list">
          {archivePosts.map((post) => (
            <article class="blog-archive-story">
              <div class="blog-story-meta">
                <time datetime={post.datePublished}>{post.datePublished}</time>
                {post.dateModified !== post.datePublished && <span>{post.dateModified} 更新</span>}
                {post.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <h2><a href={articleHref(post.path)}>{post.title}</a></h2>
              <p>{post.description}</p>
              <a class="text-link" href={articleHref(post.path)}>阅读全文 →</a>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>
