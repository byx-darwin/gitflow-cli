---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;

const docs = [
  { title: "5 分钟快速上手", href: `${base}/quickstart/`, desc: "安装、装 Skills、验证，到跑起第一个四阶段工作流。" },
  { title: "兼容性矩阵", href: `${base}/compatibility/`, desc: "三大平台底层 CLI 的最低版本、已测试版本与功能覆盖。" },
  { title: "gf vs gh / glab", href: `${base}/compare/`, desc: "gf 与官方 CLI 的六维对比、选型建议与迁移指南。" },
  { title: "更新日志", href: `${base}/changelog/`, desc: "gf 各版本的变更记录。" },
  { title: "架构设计", href: `${base}/architecture/`, desc: "Platform trait 抽象与单向依赖流动。" },
  { title: "发布工作流", href: `${base}/release-workflow/`, desc: "make release 的版本推断与发布流程。" },
  { title: "仓库内 docs/", href: "https://github.com/byx-darwin/tap/tree/main/docs", desc: "120+ 篇设计文档、指南与研究报告。" },
];
---

<Base title="文档 — gf">
  <main class="narrow page">
    <h1 class="page-title">文档</h1>
    <p class="page-lede">gf 的文档与指南。骨架阶段先提供入口，完整文档站随增长期建设。</p>
    <div class="doc-grid">
      {
        docs.map((doc) => (
          <a class="doc-card" href={doc.href}>
            <h3>
              {doc.title} <span class="doc-arrow">→</span>
            </h3>
            <p>{doc.desc}</p>
          </a>
        ))
      }
    </div>
  </main>
</Base>
