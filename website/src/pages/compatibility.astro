---
import Base from "../layouts/Base.astro";
import matrix from "../../../docs/compatibility-matrix.json";
---

<Base title="兼容性矩阵 — gitflow-cli">
  <main>
    <h1>兼容性矩阵</h1>
    <p>数据源：<code>docs/compatibility-matrix.json</code> · 更新时间：{matrix.updated_at} · gitflow-cli v{matrix.gitflow_cli_version}</p>
    <table>
      <thead>
        <tr><th>平台</th><th>CLI 工具</th><th>最低版本</th><th>已测试版本</th><th>功能覆盖</th></tr>
      </thead>
      <tbody>
        {matrix.platforms.map((p) => (
          <tr>
            <td>{p.name}</td>
            <td><code>{p.cli_binary}</code></td>
            <td>≥ {p.min_version}</td>
            <td>{p.tested_versions.join(", ")}</td>
            <td>{Object.entries(p.features).filter(([, ok]) => ok).map(([k]) => `${k} ✅`).join(" ")}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </main>
</Base>
