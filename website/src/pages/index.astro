---
import Base from "../layouts/Base.astro";
---

<Base title="gitflow-cli — 跨平台 Git 工程化工作流编排框架">
  <main>
    <h1>gitflow-cli</h1>
    <p class="tagline">
      跨平台 Git 工程化工作流编排框架：统一封装 GitHub / GitLab / GitCode 三大平台，配合 AI Agent
      Skills，覆盖从需求到发布的完整工程循环。
    </p>
    <img src={`${import.meta.env.BASE_URL}/demo.svg`} alt="gitflow-cli 演示" class="demo" />
    <pre class="install"><code>brew tap byx-darwin/gitflow-cli && brew install gitflow-cli
# 或
cargo install gitflow-cli</code></pre>
    <nav class="cta">
      <a href={`${import.meta.env.BASE_URL}/quickstart/`}>5 分钟快速上手</a>
      <a href={`${import.meta.env.BASE_URL}/compatibility/`}>兼容性矩阵</a>
      <a href={`${import.meta.env.BASE_URL}/docs/`}>文档</a>
      <a href="https://github.com/byx-darwin/gitflow-cli">GitHub</a>
    </nav>
  </main>
</Base>
