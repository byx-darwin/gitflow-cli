---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import type { TermLine } from "../components/Terminal.astro";
import CopyCommand from "../components/CopyCommand.astro";
import CommandTabs from "../components/CommandTabs.astro";
import type { Tab } from "../components/CommandTabs.astro";
import { BLOG_POSTS } from "../data/blog";
import { withBasePath } from "../lib/paths";

const base = import.meta.env.BASE_URL;
const recentPosts = BLOG_POSTS.slice(0, 3);

const heroTerminal: TermLine[] = [
  { type: "cmd", text: "export GF_DECISION_PROVIDER=jev" },
  { type: "cmd", text: "gf decide batch --input decision.json" },
  { type: "success", text: "✔ typed response validated" },
  { type: "out", text: "provider: jev-latest" },
  { type: "out", text: "policy: advisory only" },
  { type: "hl", text: "Noul | Choice | Score | Batch" },
];

const decisionTypes = [
  { name: "Noul", body: "用肯定、否定或未知回答边界明确的问题。" },
  { name: "Choice", body: "只在给定候选中选择，拒绝自由发挥。" },
  { name: "Score", body: "按有序尺度评估风险、质量与优先级。" },
  { name: "Batch", body: "一次请求组合多种问题，返回可校验结果。" },
];

const workflow = [
  { title: "需求澄清", body: "brainstorming 探索上下文，创建并审查 Issue，产出设计文档。" },
  { title: "计划制定", body: "writing-plans 生成完整实施计划，质量门禁层层把关。" },
  { title: "执行", body: "worktree 隔离开发 + 本地验证，按需本地合并或创建 PR。" },
  { title: "交付检查", body: "流水线分析、Issue 分流、代码审查与 dogfooding。" },
];

const commandTabs: Tab[] = [
  {
    label: "decide",
    lines: [
      { cmd: "gf decide noul --input request.json", desc: "边界判断" },
      { cmd: "gf decide batch --input request.json", desc: "混合类型决策" },
      { cmd: "gf decide eval --fixtures cases.json --responses saved.json", desc: "离线评估" },
    ],
  },
  {
    label: "issue",
    lines: [
      { cmd: "gf issue list", desc: "自动检测平台" },
      { cmd: 'gf issue create --title "feat: …"', desc: "创建 Issue" },
      { cmd: "gf issue view 97", desc: "查看详情" },
    ],
  },
  {
    label: "pr",
    lines: [
      { cmd: "gf pr create", desc: "创建 PR" },
      { cmd: "gf pr list --state open", desc: "列出 PR" },
      { cmd: "gf pr merge 112", desc: "合并" },
    ],
  },
  {
    label: "release",
    lines: [
      { cmd: "gf release create v1.0.0", desc: "创建发布" },
      { cmd: "gf release list", desc: "发布列表" },
    ],
  },
  {
    label: "review",
    lines: [
      { cmd: "gf review approve 112", desc: "批准" },
      { cmd: "gf review comment 112", desc: "评论" },
    ],
  },
  {
    label: "workflow",
    lines: [
      { cmd: "/gf-workflow", desc: "四阶段全流程编排" },
      { cmd: "/gf-quality", desc: "本地质量门禁" },
    ],
  },
];

const infraBadges = [
  "TypeSafe Jev",
  "Claude Code",
  "Codex",
  "Gemini CLI",
  "Copilot",
  "OpenCode",
  "Qoder",
  "Pi",
  "gh",
  "glab",
  "gitcode",
  "Rust 2024",
  "toon",
  "MIT",
];
---

<Base
  title="gf + Jev：把类型化 AI 决策接进工程工作流"
  description="gf 将 TypeSafe Jev 的类型化 AI 决策接入跨平台 Git 工程工作流，并用确定性规则、显式授权和人工审查守住边界。"
>
  <main class="landing">
    <!-- Hero：Jev 决策视觉 + 价值主张 -->
    <section class="hero-split">
      <div class="hero-copy">
        <span class="hero-kicker">gf × TypeSafe Jev</span>
        <h1 class="hero-title">把 Jev 的判断力，<br /><span class="accent">放进工程护栏。</span></h1>
        <p class="hero-sub">
          类型化 AI 决策接入跨平台 Git 工作流，始终由确定性规则和人工审查兜底。
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={`${base}/jev/`}>了解 Jev</a>
          <a class="btn btn-ghost" href={`${base}/quickstart/`}>快速上手</a>
        </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-art">
          <img
            src={`${base}/assets/jev-decision-flow.webp`}
            width="1600"
            height="667"
            alt="类型化决策信号依次通过工程检查点并收敛为可验证结果"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>语义判断进入工作流，授权边界仍由规则控制。</figcaption>
        </figure>
      </div>
    </section>

    <!-- Jev 核心能力 -->
    <section class="section jev-feature" id="jev">
      <div class="jev-feature-copy reveal">
        <h2 class="section-heading">Jev 负责判断，规则负责授权。</h2>
        <p class="section-lede">
          gf 只在显式启用时调用 Jev。响应经过类型和问题集合校验，失败时回到确定性规则或人工审查，不让模型直接改变仓库状态。
        </p>
        <a class="text-link" href={`${base}/jev/`}>查看 Jev 集成与安全边界 →</a>
      </div>
      <div class="reveal jev-terminal" style="transition-delay:100ms">
        <Terminal lines={heroTerminal} title="gf decide" />
      </div>
      <div class="decision-types">
        {
          decisionTypes.map((type, i) => (
            <article class="decision-type reveal" style={`transition-delay:${i * 70}ms`}>
              <h3>{type.name}</h3>
              <p>{type.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 四阶段工作流横轴 -->
    <section class="section">
      <div class="reveal"><h2 class="section-heading">一个命令，跑完整个工程循环</h2></div>
      <ol class="workflow">
        {
          workflow.map((step, i) => (
            <div class="reveal" style={`transition-delay:${i * 90}ms`}>
              <li class="workflow-step">
                <span class="workflow-num">{String(i + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            </div>
          ))
        }
      </ol>
    </section>

    <!-- 不对称 Bento 特性 -->
    <section class="section">
      <div class="reveal"><h2 class="section-heading">为什么是 gf</h2></div>
      <div class="bento">
        <div class="reveal bento-big">
          <div class="bento-card">
            <h3>确定性护栏，不让模型越权</h3>
            <p>
              Jev 输出只提供只读建议。gf 保留原有合同门禁、输入边界、响应校验和人工确认，任何写操作仍走明确的 CLI 权限路径。
            </p>
            <div class="badge-row">
              <span class="bento-badge">opt-in</span>
              <span class="bento-badge">read-only</span>
              <span class="bento-badge">fallback-safe</span>
            </div>
          </div>
        </div>
        <div class="reveal" style="transition-delay:70ms">
          <div class="bento-card">
            <h3>类型化决策</h3>
            <p>Noul、Choice、Score、Batch 四种问题模型，输出可验证 JSON。</p>
          </div>
        </div>
        <div class="reveal" style="transition-delay:140ms">
          <div class="bento-card">
            <h3>离线评估</h3>
            <p>保存响应、校准阈值、对比基线，不必每次都调用在线服务。</p>
          </div>
        </div>
        <div class="reveal" style="transition-delay:210ms">
          <div class="bento-card">
            <h3>质量门禁</h3>
            <p>build → test → coverage → fmt → static → pre-commit，全绿才能交付。</p>
          </div>
        </div>
        <div class="reveal" style="transition-delay:280ms">
          <div class="bento-card">
            <h3>跨平台 Git</h3>
            <p>同一命令面覆盖 GitHub、GitLab、GitCode，自动识别 remote。</p>
          </div>
        </div>
        <div class="reveal" style="transition-delay:350ms">
          <div class="bento-card">
            <h3>Dogfooding</h3>
            <p>用 gf 开发 gf：它自己的工作流就是最好的案例。<a href={`${base}/dogfooding/`}>看真实案例 →</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 最新文章 -->
    <section class="section home-blog" aria-labelledby="home-blog-title">
      <div class="home-blog-heading reveal">
        <div>
          <h2 class="section-heading" id="home-blog-title">工程实践与设计记录</h2>
          <p class="section-lede">从真实项目中提炼工作流、质量门禁和 AI 决策的边界。</p>
        </div>
        <a class="text-link" href={withBasePath(base, "/blog/")}>查看全部文章 →</a>
      </div>
      <div class="home-blog-list">
        {recentPosts.map((post, i) => (
          <article class="home-blog-story reveal" style={`transition-delay:${i * 70}ms`}>
            <div class="blog-story-meta">
              <time datetime={post.datePublished}>{post.datePublished}</time>
              {post.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <h3><a href={withBasePath(base, post.path)}>{post.title}</a></h3>
            <p>{post.description}</p>
            <a class="text-link" href={withBasePath(base, post.path)}>阅读全文 →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Agent 平台 / 底层 CLI 横滚带 -->
    <section class="section marquee-band" aria-label="支持的 Agent 平台与底层 CLI">
      <div class="marquee">
        <div class="marquee-track">
          {[...infraBadges, ...infraBadges].map((badge) => (
            <span class="marquee-badge">{badge}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- 命令速览 Tabs -->
    <section class="section narrow" style="padding-left:24px;padding-right:24px">
      <div class="reveal"><h2 class="section-heading">命令速览</h2></div>
      <div class="reveal" style="transition-delay:100ms">
        <CommandTabs tabs={commandTabs} />
      </div>
    </section>

    <!-- 安装 CTA -->
    <section class="section cta-band">
      <div class="reveal">
        <h2 class="cta-heading">让 Jev 判断，让 gf 守住边界。</h2>
        <CopyCommand command="brew tap byx-darwin/tap && brew install gf" />
        <p class="cta-note">MIT License | Rust 2024 | 支持 GitHub / GitLab / GitCode</p>
      </div>
    </section>
  </main>
</Base>
