---
import Base from "../layouts/Base.astro";
import { withBasePath } from "../lib/paths";
import { readFileSync } from "node:fs";

const base = import.meta.env.BASE_URL;
const gfVersion = readFileSync(
  new URL("../../../Cargo.toml", import.meta.url),
  "utf-8",
).match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? "";
const currentMinor = gfVersion.replace(/\.\d+$/, ".x");
---

<Base title="支持政策 — gf">
  <main class="narrow page">
    <h1 class="page-title">支持政策</h1>
    <p class="page-lede">
      gf 版本支持周期与升级指引
    </p>

    <h2>支持的版本</h2>
    <table class="matrix-table">
      <thead>
        <tr><th>版本</th><th>支持状态</th><th>EOL 日期</th><th>备注</th></tr>
      </thead>
      <tbody>
        <tr>
          <td class="matrix-platform">{currentMinor}</td>
          <td class="matrix-ok">✅ 支持中</td>
          <td>TBD</td>
          <td>当前稳定版本</td>
        </tr>
        <tr>
          <td class="matrix-platform">其他历史版本</td>
          <td>⚠️ 尽力支持</td>
          <td>-</td>
          <td>不保证回移修复，建议升级到当前版本</td>
        </tr>
      </tbody>
    </table>

    <h2>获取帮助</h2>
    <ul>
      <li><strong>Bug 报告：</strong>在 GitHub 上提交 Issue</li>
      <li><strong>功能建议：</strong>在 GitHub Discussions 发起讨论</li>
      <li><strong>安全问题：</strong>发送邮件至 baoyx19870908@gmail.com（私信）</li>
    </ul>

    <h2>兼容性矩阵</h2>
    <p>
      平台兼容性详情见 <a href={withBasePath(base, "/compatibility/")} style="color:var(--gf-teal)">兼容性矩阵</a>。
    </p>

    <h2>升级指南</h2>
    <h3>升级到 {currentMinor}</h3>
    <ul>
      <li>通过 <code>brew upgrade gf</code> 或 <code>cargo install --force gitflow-cli</code> 升级 CLI</li>
      <li>运行 <code>gf skills install --force</code> 同步当前 30 个官方 Skills</li>
      <li>运行 <code>gf doctor</code> 检查 Agent、底层平台 CLI 和 Skills 状态</li>
      <li>跨主版本升级前请阅读 <a href={withBasePath(base, "/changelog/")} style="color:var(--gf-teal)">更新日志</a></li>
    </ul>
  </main>
</Base>
