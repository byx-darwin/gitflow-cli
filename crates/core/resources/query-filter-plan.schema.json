{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gf.ai/schemas/query-filter-plan-v1.json",
  "type": "object",
  "required": ["schemaVersion", "target", "filters", "sources", "unresolved"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {"enum": ["issue", "pr"]},
    "filters": {"type": "array", "maxItems": 16, "items": {"oneOf": [
      {"$ref": "#/$defs/state"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/author"},
      {"$ref": "#/$defs/assignee"}, {"$ref": "#/$defs/label"}, {"$ref": "#/$defs/created_after"},
      {"$ref": "#/$defs/created_before"}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/draft"},
      {"$ref": "#/$defs/merged"}, {"$ref": "#/$defs/ci"}
    ]}},
    "sources": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "required": ["filterIndex", "span", "origin", "confidence"],
      "properties": {"filterIndex": {"type": "integer", "minimum": 0, "maximum": 15}, "span": {"type": "string", "minLength": 1, "maxLength": 128}, "origin": {"enum": ["deterministic", "jev"]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}},
      "additionalProperties": false
    }},
    "unresolved": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "additionalProperties": false,
  "$defs": {
    "state": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "state"}, "value": {"enum": ["open", "closed", "all"]}}, "additionalProperties": false},
    "number": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "number"}, "value": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "author": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "author"}, "value": {"type": "string"}}, "additionalProperties": false},
    "assignee": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "assignee"}, "value": {"type": "string"}}, "additionalProperties": false},
    "label": {"type": "object", "required": ["field", "value", "negated"], "properties": {"field": {"const": "label"}, "value": {"type": "string"}, "negated": {"type": "boolean"}}, "additionalProperties": false},
    "created_after": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "created_after"}, "value": {"type": "string", "format": "date"}}, "additionalProperties": false},
    "created_before": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "created_before"}, "value": {"type": "string", "format": "date"}}, "additionalProperties": false},
    "text": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "text"}, "value": {"type": "string"}}, "additionalProperties": false},
    "draft": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "draft"}, "value": {"type": "boolean"}}, "additionalProperties": false},
    "merged": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "merged"}, "value": {"type": "boolean"}}, "additionalProperties": false},
    "ci": {"type": "object", "required": ["field", "value"], "properties": {"field": {"const": "ci"}, "value": {"type": "string"}}, "additionalProperties": false}
  }
}
