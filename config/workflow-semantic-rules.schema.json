{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gf.ai/schemas/workflow-semantic-rules-v1.json",
  "type": "object",
  "required": ["schemaVersion", "policyVersion", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policyVersion": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "rules": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/rule"}}
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "phase", "pathPrefixes", "instruction", "question", "severity", "threshold", "failurePolicy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "phase": {"enum": ["plan", "execute", "deliver"]},
        "pathPrefixes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 256}},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 512},
        "question": {"oneOf": [{"type": "object", "required": ["type"], "properties": {"type": {"const": "noul"}}, "additionalProperties": false}, {"type": "object", "required": ["type", "levels"], "properties": {"type": {"const": "score"}, "levels": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "string", "maxLength": 128}}}, "additionalProperties": false}, {"type": "object", "required": ["type", "categories"], "properties": {"type": {"const": "choice"}, "categories": {"type": "object", "minProperties": 2, "maxProperties": 16, "required": ["none"], "additionalProperties": {"type": "string", "maxLength": 128}}}, "additionalProperties": false}]},
        "severity": {"enum": ["info", "low", "medium", "high"]},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "failurePolicy": {"enum": ["observe", "warn", "require_review"]}
      },
      "additionalProperties": false
    }
  }
}
