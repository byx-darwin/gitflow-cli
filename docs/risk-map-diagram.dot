digraph gitflow_risk_map {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    splines=ortho;
    label="gitflow-cli (gf) Risk Map\n7 identified risks with severity";
    labelloc=t;
    fontsize=14;
    nodesep=0.4;
    ranksep=0.6;
    pad=0.3;

    // ── Architecture anchors (simplified) ──
    subgraph cluster_arch {
        label="Architecture Components";
        style=filled;
        color="#f0f0f0";

        main_rs [label="main.rs\nentrypoint", shape=box, style=filled, fillcolor="#dae8fc"];
        platform_detect [label="resolve_platform", shape=box, style=filled, fillcolor="#fff2cc"];
        commands [label="commands::*", shape=box, style=filled, fillcolor="#dae8fc"];
        adapters [label="Platform Adapters\n(github/gitlab/gitcode)", shape=box, style=filled, fillcolor="#f5f5f5"];
        ext_cli [label="External CLIs\n(gh/glab/gitcode/git)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        docs [label="docs/architecture.md", shape=folder, style=filled, fillcolor="#f5f5f5"];
    }

    // ── HIGH risks ─
    subgraph cluster_high {
        label="HIGH Severity";
        style=filled;
        color="#f8cecc";
        fontcolor="#cc0000";

        R1 [label="R1: Platform detection\nfallback to GitLab\n(unrecognized = GitLab)", shape=note, style=filled, fillcolor="#f8cecc"];
        R2 [label="R2: Sync git call in\nasync entrypoint\n(blocking I/O)", shape=note, style=filled, fillcolor="#f8cecc"];
        R6 [label="R6: External CLI\ndependency\n(gh/glab/gitcode)", shape=note, style=filled, fillcolor="#f8cecc"];
    }

    // ── MEDIUM risks ──
    subgraph cluster_medium {
        label="MEDIUM Severity";
        style=filled;
        color="#fff2cc";
        fontcolor="#cc6600";

        R3 [label="R3: Adapter code\nduplication\n(3x identical modules)", shape=note, style=filled, fillcolor="#fff2cc"];
        R4 [label="R4: Architecture docs\noutdated\n(missing adapter crates)", shape=note, style=filled, fillcolor="#fff2cc"];
        R5 [label="R5: SIGPIPE handling\ndisabled\n(pipe exit panic)", shape=note, style=filled, fillcolor="#fff2cc"];
        R7 [label="R7: No shared adapter\nstate (Box per call)", shape=note, style=filled, fillcolor="#fff2cc"];
    }

    // ── Risk → Component edges ──
    platform_detect -> R1 [color="#cc0000", style=bold];
    main_rs -> R2 [color="#cc0000", style=bold];
    adapters -> R6 [color="#cc0000", style=bold];
    ext_cli -> R6 [color="#cc0000", style=bold, constraint=false];

    adapters -> R3 [color="#cc6600"];
    R4 -> docs [color="#cc6600"];
    main_rs -> R5 [color="#cc6600"];
    commands -> R7 [color="#cc6600"];
}
