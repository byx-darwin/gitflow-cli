digraph gitflow_architecture_review {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    splines=curved;
    label="gitflow-cli (gf) Architecture Risk Map\nrisk-quality-reviewer + graphviz";
    labelloc=t;
    fontsize=14;
    nodesep=0.5;
    ranksep=0.8;
    pad=0.4;

    // ── CLI Layer ──
    subgraph cluster_cli {
        label="apps/cli (gf binary)";
        style=filled;
        color="#dae8fc";
        main_rs [label="main.rs\nentrypoint\nSIGPIPE disabled"];
        router [label="router()\ncommand dispatch"];
        prereqs [label="prerequisites\ncheck"];
        platform_detect [label="resolve_platform\nURL detection", style=filled, fillcolor="#fff2cc"];
        commands [label="commands::*\n14 subcommands"];
        output_fmt [label="OutputFormat\njson|text|toon|auto"];

        main_rs -> router;
        main_rs -> platform_detect;
        main_rs -> prereqs;
        router -> commands;
        commands -> output_fmt;
    }

    // ── Ecosystem (same rank as CLI) ──
    subgraph cluster_ecosystem {
        label="Ecosystem";
        style=dashed;
        color=gray;
        skills [label="26+ AI Skills\n(gf-*)", shape=component];
        hooks [label="Hooks\npre-commit", shape=component];
        self_update [label="self_update\nEd25519 verify", shape=component];
    }

    // ── Core Layer ──
    subgraph cluster_core {
        label="crates/core (gitflow-core)";
        style=filled;
        color="#e1d5e7";
        traits [label="Provider Traits\nIssueProvider\nPrProvider\nReleaseProvider\nReviewProvider\nAuthProvider\nLabelProvider\nCommitProvider\nPipelineProvider"];
        domain [label="Domain Types\nIssueData, PrData\nReleaseData, ReviewData\nCommentData, MergeResult"];
        errors [label="CoreError\nPlatformCliError\nSafePath"];
        toon [label="TOON output\n(LLM format)"];

        traits -> domain;
        traits -> errors;
    }

    // ─ Adapter Layer ──
    subgraph cluster_adapters {
        label="Platform Adapters";
        style=filled;
        color="#f5f5f5";
        github_adapter [label="gitflow-github\nGitHubPrProvider\nGitHubIssueProvider\n..."];
        gitlab_adapter [label="gitflow-gitlab\nGitLabMrProvider\nGitLabIssueProvider\n..."];
        gitcode_adapter [label="gitflow-gitcode\nGitCodePrProvider\nGitCodeIssueProvider\n..."];
        runner_trait [label="CommandRunner trait\nRealCommandRunner\nMockCommandRunner"];
    }

    // ── External Dependencies ──
    subgraph cluster_external {
        label="External Dependencies";
        style=dashed;
        color=gray;
        gh [label="gh CLI\n(GitHub)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        glab [label="glab CLI\n(GitLab)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        gitcode_cli [label="gitcode CLI\n(GitCode)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        git_bin [label="git binary", shape=box3d, style=filled, fillcolor="#d5e8d4"];
    }

    // ── Main Dependency Edges ──
    commands -> traits [label="Box<dyn Trait>"];
    commands -> toon;
    github_adapter -> traits [label="impl"];
    gitlab_adapter -> traits [label="impl"];
    gitcode_adapter -> traits [label="impl"];
    github_adapter -> runner_trait;
    gitlab_adapter -> runner_trait;
    gitcode_adapter -> runner_trait;
    github_adapter -> gh;
    gitlab_adapter -> glab;
    gitcode_adapter -> gitcode_cli;
    platform_detect -> git_bin [label="sync call", style=bold, color="#cc0000"];
    skills -> commands [label="invoke via\nshell", style=dashed];
    hooks -> commands [style=dashed];
    main_rs -> self_update;

    // ── Risk Nodes (two rows at bottom) ──
    {
        rank=sink;

        R1 [label="R1: Platform detection\nfallback to GitLab", shape=note, style=filled, fillcolor="#f8cecc"];
        R2 [label="R2: Sync git call in\nasync entrypoint", shape=note, style=filled, fillcolor="#f8cecc"];
        R6 [label="R6: External CLI\ndependency (gh/glab/gitcode)", shape=note, style=filled, fillcolor="#f8cecc"];

        R3 [label="R3: Adapter code\nduplication", shape=note, style=filled, fillcolor="#fff2cc"];
        R4 [label="R4: Architecture docs\noutdated", shape=note, style=filled, fillcolor="#fff2cc"];
        R5 [label="R5: SIGPIPE handling\ndisabled", shape=note, style=filled, fillcolor="#fff2cc"];
        R7 [label="R7: No shared adapter\nstate (Box per call)", shape=note, style=filled, fillcolor="#fff2cc"];

        docs_node [label="docs/architecture.md", shape=folder, style=filled, fillcolor="#f5f5f5"];

        // Force two rows within sink rank
        edge [style=invis];
        R1 -> R3;
        R2 -> R4;
        R6 -> R5;
    }

    subgraph cluster_risks_label {
        label="Identified Risks";
        style=dashed;
        color="#cc0000";
        fontcolor="#cc0000";
        style=invis;
        risk_anchor [style=invis, label=""];
    }

    // Risk edges — constraint=false keeps them out of the main rank flow
    platform_detect -> R1 [style=dashed, color="#cc0000", constraint=false];
    main_rs -> R2 [style=dashed, color="#cc0000", constraint=false];
    github_adapter -> R6 [style=dashed, color="#cc0000", constraint=false];
    gitlab_adapter -> R6 [style=dashed, color="#cc0000", constraint=false];
    gitcode_adapter -> R6 [style=dashed, color="#cc0000", constraint=false];
    github_adapter -> R3 [style=dashed, color="#cc6600", constraint=false];
    gitlab_adapter -> R3 [style=dashed, color="#cc6600", constraint=false];
    gitcode_adapter -> R3 [style=dashed, color="#cc6600", constraint=false];
    R4 -> docs_node [style=dashed, color="#cc6600", constraint=false];
    main_rs -> R5 [style=dashed, color="#cc6600", constraint=false];
    commands -> R7 [style=dashed, color="#cc6600", constraint=false];
}
