digraph gitflow_architecture {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, shape=box, margin="0.36,0.10"];
    edge [fontname="Helvetica", fontsize=8];
    label="gitflow-cli (gf) Architecture Overview — dependency-derived (cargo metadata)";
    labelloc=t;
    fontsize=14;
    nodesep=0.5;
    ranksep=0.9;
    pad=0.4;

    // ── CLI Layer ──
    subgraph cluster_cli {
        label="apps/cli (gf binary)";
        style=filled;
        color="#dae8fc";
        "gitflow-cli" [fillcolor="#dae8fc", style=filled];
    }

    // ── Core Layer ──
    subgraph cluster_core {
        label="crates/core (gitflow-core)";
        style=filled;
        color="#e1d5e7";
        "gitflow-core" [fillcolor="#e1d5e7", style=filled];
    }

    // ── Adapter Layer ──
    subgraph cluster_adapters {
        label="Platform Adapters";
        style=filled;
        color="#f5f5f5";
        "gitflow-github" [fillcolor="#f5f5f5", style=filled];
        "gitflow-gitlab" [fillcolor="#f5f5f5", style=filled];
        "gitflow-gitcode" [fillcolor="#f5f5f5", style=filled];
        "gitflow-cli-adapter-utils" [fillcolor="#f5f5f5", style=filled];
    }

    // ── E2E Test Harness ──
    subgraph cluster_e2e {
        label="E2E Test Harness (e2e-*)";
        style=filled;
        color="#fff2cc";
        "e2e-core" [fillcolor="#fff2cc", style=filled];
        "e2e-github" [fillcolor="#fff2cc", style=filled];
        "e2e-gitlab" [fillcolor="#fff2cc", style=filled];
        "e2e-gitcode" [fillcolor="#fff2cc", style=filled];
    }

    // ── Ecosystem ──
    subgraph cluster_ecosystem {
        label="Ecosystem";
        style=dashed;
        color=gray;
        skills [label="26+ AI Skills\n(gf-*)", shape=component];
        hooks [label="Hooks\npre-commit", shape=component];
        self_update [label="self_update\nEd25519 verify", shape=component];
        "release-signer" [shape=box, fillcolor="#fff2cc", style=filled];
    }

    // ── Real dependency edges (cargo metadata --no-deps) ──
    "gitflow-cli" -> "gitflow-core";
    "gitflow-cli" -> "gitflow-gitcode";
    "gitflow-cli" -> "gitflow-github";
    "gitflow-cli" -> "gitflow-gitlab";
    "gitflow-gitcode" -> "gitflow-cli-adapter-utils";
    "gitflow-gitcode" -> "gitflow-core";
    "gitflow-github" -> "gitflow-cli-adapter-utils";
    "gitflow-github" -> "gitflow-core";
    "gitflow-gitlab" -> "gitflow-cli-adapter-utils";
    "gitflow-gitlab" -> "gitflow-core";
    "e2e-gitcode" -> "e2e-core";
    "e2e-github" -> "e2e-core";
    "e2e-gitlab" -> "e2e-core";
}
