digraph gitflow_architecture {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    label="gitflow-cli (gf) Architecture Overview";
    labelloc=t;
    fontsize=14;
    nodesep=0.5;
    ranksep=0.8;
    pad=0.4;

    // ── CLI Layer ──
    subgraph cluster_cli {
        label="apps/cli (gf binary)";
        style=filled;
        color="#dae8fc";
        main_rs [label="main.rs\nentrypoint\nSIGPIPE disabled"];
        router [label="router()\ncommand dispatch"];
        prereqs [label="prerequisites\ncheck"];
        platform_detect [label="resolve_platform\nURL detection", style=filled, fillcolor="#fff2cc"];
        commands [label="commands::*\n14 subcommands"];
        output_fmt [label="OutputFormat\njson|text|toon|auto"];

        main_rs -> router;
        main_rs -> platform_detect;
        main_rs -> prereqs;
        router -> commands;
        commands -> output_fmt;
    }

    // ── Ecosystem ──
    subgraph cluster_ecosystem {
        label="Ecosystem";
        style=dashed;
        color=gray;
        skills [label="26+ AI Skills\n(gf-*)", shape=component];
        hooks [label="Hooks\npre-commit", shape=component];
        self_update [label="self_update\nEd25519 verify", shape=component];
    }

    // ─ Core Layer ──
    subgraph cluster_core {
        label="crates/core (gitflow-core)";
        style=filled;
        color="#e1d5e7";
        traits [label="Provider Traits\nIssueProvider\nPrProvider\nReleaseProvider\nReviewProvider\nAuthProvider\nLabelProvider\nCommitProvider\nPipelineProvider"];
        domain [label="Domain Types\nIssueData, PrData\nReleaseData, ReviewData\nCommentData, MergeResult"];
        errors [label="CoreError\nPlatformCliError\nSafePath"];
        toon [label="TOON output\n(LLM format)"];

        traits -> domain;
        traits -> errors;
    }

    // ─ Adapter Layer ──
    subgraph cluster_adapters {
        label="Platform Adapters";
        style=filled;
        color="#f5f5f5";
        github_adapter [label="gitflow-github\nGitHubPrProvider\nGitHubIssueProvider\n..."];
        gitlab_adapter [label="gitflow-gitlab\nGitLabMrProvider\nGitLabIssueProvider\n..."];
        gitcode_adapter [label="gitflow-gitcode\nGitCodePrProvider\nGitCodeIssueProvider\n..."];
        runner_trait [label="CommandRunner trait\nRealCommandRunner\nMockCommandRunner"];
    }

    // ── External Dependencies ──
    subgraph cluster_external {
        label="External Dependencies";
        style=dashed;
        color=gray;
        gh [label="gh CLI\n(GitHub)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        glab [label="glab CLI\n(GitLab)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        gitcode_cli [label="gitcode CLI\n(GitCode)", shape=box3d, style=filled, fillcolor="#d5e8d4"];
        git_bin [label="git binary", shape=box3d, style=filled, fillcolor="#d5e8d4"];
    }

    // ── Main Dependency Edges ──
    commands -> traits [label="Box<dyn Trait>"];
    commands -> toon;
    github_adapter -> traits [label="impl"];
    gitlab_adapter -> traits [label="impl"];
    gitcode_adapter -> traits [label="impl"];
    github_adapter -> runner_trait;
    gitlab_adapter -> runner_trait;
    gitcode_adapter -> runner_trait;
    github_adapter -> gh;
    gitlab_adapter -> glab;
    gitcode_adapter -> gitcode_cli;
    platform_detect -> git_bin [label="sync call", style=bold, color="#cc0000"];
    skills -> commands [label="invoke via\nshell", style=dashed];
    hooks -> commands [style=dashed];
    main_rs -> self_update;
}
